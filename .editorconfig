# EditorConfig. https://editorconfig.org
# Paired with .gitattributes: that file decides what lands in the repository,
# this one decides what the editor writes.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h,cpp,hpp,ino}]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 88

# Trailing whitespace is significant in Markdown, so it is not trimmed here.
[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.{json,xml,urdf,xacro,sdf}]
indent_size = 2

[*.ini]
indent_size = 4

[Makefile]
indent_style = tab

# Generated by STM32CubeMX. Any formatting imposed is lost on regeneration.
[*.ioc]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{bat,cmd}]
end_of_line = crlf

# The guide documents are source material. Leave them exactly as they arrived.
[docs/guides/*.md]
trim_trailing_whitespace = false
insert_final_newline = false
max_line_length = off
